{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hotels.csv row",
  "type": "object",
  "required": ["hotel_id","name","city","country","star_rating","price_per_night_usd","amenities","available_rooms","check_in_date","check_out_date"],
  "properties": {
    "hotel_id":            { "type": "string", "pattern": "^CT-HT-\\d{3,}$" },
    "name":                { "type": "string", "minLength": 1 },
    "city":                { "type": "string", "minLength": 1 },
    "country":             { "type": "string", "minLength": 1 },
    "star_rating":         { "type": "string", "pattern": "^[1-5]$" },
    "price_per_night_usd": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
    "amenities":           { "type": "string" },
    "available_rooms":     { "type": "string", "pattern": "^\\d+$" },
    "check_in_date":       { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "check_out_date":      { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
