{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "evaluator artifact",
  "type": "object",
  "required": ["name", "kind"],
  "properties": {
    "name":        { "type": "string", "minLength": 1 },
    "kind":        { "type": "string", "enum": ["built-in", "custom"] },
    "metric":      { "type": "string" },
    "description": { "type": "string" }
  }
}
