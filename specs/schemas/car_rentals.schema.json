{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "car_rentals.csv row",
  "type": "object",
  "required": ["rental_id","company","city","car_type","price_per_day_usd","available","pickup_date","return_date"],
  "properties": {
    "rental_id":         { "type": "string", "pattern": "^CT-CR-\\d{3,}$" },
    "company":           { "type": "string", "minLength": 1 },
    "city":              { "type": "string", "minLength": 1 },
    "car_type":          { "type": "string", "minLength": 1 },
    "price_per_day_usd": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$" },
    "available":         { "type": "string", "enum": ["true","false"] },
    "pickup_date":       { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "return_date":       { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
